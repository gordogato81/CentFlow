# ---- Build stage -------------------------------------------------------------
# Wheels are built in the build stage and only the wheels are carried into the
# runtime image, so no compiler toolchain or build headers reach production.
FROM python:3.13-slim AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY requirements-prod.txt ./

# The cache mount persists downloaded artifacts between builds; --no-cache-dir
# keeps them out of the layer. pip already ships current in the base image, so
# upgrading it only added a network round trip.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip wheel --wheel-dir /wheels -r requirements-prod.txt

# ---- Runtime stage -----------------------------------------------------------
FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_DIR=/var/opt/centflow \
    FLASK_APP=app.py \
    FLASK_DEBUG=0 \
    FLASK_ENV=production

WORKDIR ${APP_DIR}

COPY --from=build /wheels /wheels
COPY requirements-prod.txt ./

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --no-index --find-links=/wheels -r requirements-prod.txt \
    && rm -rf /wheels

# Application code is baked in so the image is self-contained and immutable.
COPY --chown=nobody:nogroup code/ ./

EXPOSE 5000

# Drop privileges. The service is stateless and needs no writable path.
USER nobody

# gunicorn runs as PID 1 and handles SIGTERM directly, so no shell wrapper.
CMD ["gunicorn", "--workers=4", "--timeout=120", "--log-level=info", \
     "--access-logfile=-", "--bind", "0.0.0.0:5000", "app:app"]
