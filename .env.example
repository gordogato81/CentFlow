# Copy this file to `.env` in the repository root before running
#   docker compose -f docker-compose.prod.yml up -d
#
# Docker Compose loads `.env` automatically from the project directory and uses
# it for variable substitution in docker-compose.prod.yml. These values are
# host-specific paths, so the real file is not tracked in git.

# Absolute host path to the TLS certificate chain used by the cent-frontend
# nginx, normally the copy managed by Nginx Proxy Manager.
FRONTEND_TLS_CERT_PATH=/path/to/letsencrypt/live/<cert-name>/fullchain.pem

# Absolute host path to the matching private key.
FRONTEND_TLS_KEY_PATH=/path/to/letsencrypt/live/<cert-name>/privkey.pem

# Name of the external Docker network that Nginx Proxy Manager publishes on.
# Defaults to "npm_proxy" when unset.
NPM_EXTERNAL_NETWORK=npm_proxy
